{
  "name": "pendle-frens",
  "version": "1.0.0",
  "private": true,
  "description": "A read-only Chrome side panel for finding risk-adjusted fixed-yield PT opportunities on Pendle, and for pricing what an entry, exit or roll-over costs at your size.",
  "type": "module",
  "license": "MIT",
  "author": "Rex Zhou <zhouzhuojie@gmail.com>",
  "homepage": "https://github.com/zhouzhuojie/pendle-frens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouzhuojie/pendle-frens.git"
  },
  "bugs": {
    "url": "https://github.com/zhouzhuojie/pendle-frens/issues"
  },
  "keywords": [
    "pendle",
    "chrome-extension",
    "manifest-v3",
    "defi",
    "fixed-yield",
    "yield",
    "typescript"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run typecheck && vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand": "node scripts/gen-brand.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.278",
    "@types/node": "^22.20.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.11"
  }
}
